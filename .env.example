# Generate real credentials: node scripts/setup-env.js
PORT=3001
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5433
# Existing Compose volume by default. --fresh-db generates a different name.
POSTGRES_VOLUME=ecommerce-api_postgres_data
# Local Node connection; Compose overrides this with postgres:5432.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=1h
